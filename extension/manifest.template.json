{
  "manifest_version": 3,
  "name": "Bluff Checkout Guard",
  "version": "1.1.0",
  "description": "Checks a store with Bluff when a page asks for your card number or CVV, before you pay. Never reads what you type.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Bluff Checkout Guard",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "homepage_url": "",
  "permissions": ["storage"],
  "host_permissions": [],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }]
}
