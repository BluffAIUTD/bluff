# --- Modes ---------------------------------------------------------------
AGENT_MODE=mock            # mock | live
PHOTON_MODE=mock           # mock | live
DEMO_MODE=1                # 1 = shared demo user "Maya", no login
BASE_DOMAIN=localhost:3000 # bluff.<domain>; stores at <store>.<domain>
SESSION_SECRET=change-me-in-production
DEMO_KEY=change-me         # unlocks /demo?key=... controls
EVAL_KEY=change-me         # unlocks /api/eval/link
MOCK_SPEED=1               # 1 = realistic 600-1400ms gaps; 0 = instant (tests)

# --- Database (Tiger Data managed Postgres; TLS) ---------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bluff

# --- NVIDIA build.nvidia.com (OpenAI-compatible) [verify model IDs] --------
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # tool calling, ~0.5 s/turn
NEMOTRON_SMALL_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
EMBED_MODEL=
NEMOTRON_THINKING=off      # off = skip Nemotron 3.x reasoning trace (faster tool turns)

# --- Photon [verify SDK/webhook shape] -------------------------------------
PHOTON_API_BASE=
PHOTON_PROJECT_SECRET=
PHOTON_WEBHOOK_SECRET=
PHOTON_NUMBER=
DEMO_USER_PHONE=

# --- Optional ---------------------------------------------------------------
RDAP_ENABLED=0
ACME_EMAIL=you@example.com         # Let's Encrypt contact (Caddy)
PHOTON_SIGNATURE_HEADER=x-photon-signature  # [verify] header Photon signs webhooks with

# --- Capital One Nessie (bank data) ---------------------------------------
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_CUSTOMER_ID=        # optional; default = the demo customer created by npm run nessie:seed

# --- T-Mobile Safe Signal message set (game + eval) ------------------------
TMOBILE_DATA=              # path to the booth CSV/JSON/JSONL; import with npm run tmobile:import
